pd_ley21431 <- pd_ley21431 %>% arrange(-desc(periodo))
head(nombres_plataformas_para_filtrar,10) %>% kable(col.names = c("Plataformas","Ocupados mensualizado"),
format.args = list(big.mark = ".", scientific = FALSE))
