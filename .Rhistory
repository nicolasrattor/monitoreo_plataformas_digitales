#| code-fold: true
#| code-summary: "Ver código"
#| label: tbl-nuevas-plat
#| tbl-cap: "Empresas de plataformas Ley 21431 con mayor crecimiento últimos 4 años"
# 1) Último trimestre disponible en la base
trim_ref <- ds %>%
summarise(max_periodo = max(periodo, na.rm = TRUE)) %>%
pull(max_periodo)
# (opcional) asegurar clase Date si viene como character
trim_ref <- as.Date(trim_ref)
# 2) Trimestre base (4 años antes)
trim_base <- trim_ref %m-% years(4)
# 3) Pipeline
nuevas <- ds %>%
filter(periodo %in% c(trim_ref, trim_base),
plataformas_digitales == 1) %>%
filter(pd_especifique %in% nombres_plataformas_para_filtrar$pd_especifique) %>%
group_by(periodo, pd_especifique) %>%
summarise(ocupados = sum(fact_cal, na.rm = TRUE), .groups = "drop") %>%
mutate(ocupados = round(ocupados)) %>%
collect() %>%
pivot_wider(names_from = periodo, values_from = ocupados, values_fill = 0)
# 4) Nombres dinámicos de columnas
col_ref  <- as.character(trim_ref)
col_base <- as.character(trim_base)
# 5) Variación y orden
nuevas %>%
mutate(
variacion_porc = round((.data[[col_ref]] - .data[[col_base]]) / .data[[col_base]] * 100, 1)
) %>%
arrange(desc(variacion_porc), desc(.data[[col_ref]])) %>%
kable()
